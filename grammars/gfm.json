{
  "scopeName": "source.gfm",
  "type": "tree-sitter",
  "name": "Markdown",
  "parser": "tree-sitter-markdown",
  "injectionNames": ["markdown", "md", "gfm"],
  "treeSitter": {
    "parserSource": "github:lumine-code/tree-sitter-markdown/tree-sitter-markdown#8cb4fe833cdf7323fac0e1df6e5674d9f238a4f3",
    "wasmBuildTool": "tree-sitter-cli#v0.27.2",
    "grammar": "markdown.wasm",
    "highlightsQuery": "gfm-highlights.scm",
    "injectionsQuery": "gfm-injections.scm",
    "foldsQuery": "gfm-folds.scm",
    "tagsQuery": "gfm-tags.scm",
    "contentEditPolicies": {
      "content-words": "../lib/content-edit-policy.js"
    }
  },
  "fileTypes": [
    "markdown",
    "md",
    "mdown",
    "mdwn",
    "mkd",
    "mkdn",
    "mkdown",
    "rmd",
    "ron",
    "workbook"
  ],
  "comments": {
    "start": "<!--",
    "end": "-->",
    "blockStart": "<!--",
    "blockEnd": "-->"
  }
}
