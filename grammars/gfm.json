{
  "scopeName": "source.gfm",
  "type": "tree-sitter",
  "name": "GitHub Markdown",
  "parser": "tree-sitter-markdown",
  "injectionNames": ["markdown", "md", "gfm"],
  "treeSitter": {
    "parserSource": "github:tree-sitter-grammars/tree-sitter-markdown/tree-sitter-markdown#b6dac978ea390d64f842d6c2a3fb5b80d902c834",
    "wasmBuildTool": "tree-sitter-cli#v0.27.1",
    "grammar": "markdown.wasm",
    "highlightsQuery": "gfm-highlights.scm",
    "injectionsQuery": "gfm-injections.scm",
    "foldsQuery": "gfm-folds.scm",
    "tagsQuery": "gfm-tags.scm"
  },
  "fileTypes": [
    "markdown",
    "md",
    "mdown",
    "mdwn",
    "mkd",
    "mkdn",
    "mkdown",
    "rmd",
    "ron",
    "workbook"
  ],
  "comments": {
    "start": "<!--",
    "end": "-->",
    "blockStart": "<!--",
    "blockEnd": "-->"
  }
}
