{
  "scopeName": "source.gfm",
  "type": "tree-sitter",
  "name": "GitHub Markdown",
  "parser": "tree-sitter-markdown",
  "injectionNames": ["markdown", "gfm"],
  "treeSitter": {
    "parserSource": "github:tree-sitter-grammars/tree-sitter-markdown/tree-sitter-markdown#v0.5.3",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "markdown.wasm",
    "highlightsQuery": "gfm-highlights.scm",
    "foldsQuery": "gfm-folds.scm",
    "tagsQuery": "gfm-tags.scm"
  },
  "fileTypes": [
    "markdown",
    "md",
    "mdown",
    "mdwn",
    "mkd",
    "mkdn",
    "mkdown",
    "rmd",
    "ron",
    "workbook"
  ],
  "comments": {
    "start": "<!--",
    "end": "-->",
    "blockStart": "<!--",
    "blockEnd": "-->"
  }
}
